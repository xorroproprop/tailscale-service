# Copy to .env (next to service.py) and fill in what you need. Real environment variables override this file.
# Restart service.py after changing it. Never commit .env: it holds secrets (.gitignore already skips it).

# Bearer token for writes (POST /api/events). service.py creates one on first run if this is empty.
# Make your own:  python3 -c "import secrets; print(secrets.token_hex(32))"
SERVICE_TOKEN=

# Tailscale logins that may write WITHOUT the token, comma-separated. Only works through tailscale serve.
# Find yours with: curl https://<machine>.<tailnet>.ts.net:8443/whoami
WRITERS=

# Vendor API gateway: GET /upstream/<path> is forwarded to UPSTREAM_URL/<path> with the key attached.
# The key stays on this machine; callers never see it.
UPSTREAM_URL=
UPSTREAM_HEADER=Authorization
UPSTREAM_KEY=
UPSTREAM_CACHE_SECONDS=60

# Where events are stored (SQLite). Default: events.db next to service.py.
DB_PATH=
